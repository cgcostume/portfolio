---
import ThumbnailGitHub from './ThumbnailGitHub.astro';
import { header, repositories as data } from '../lib/data';

interface Props { selected?: boolean; }
const { selected = false } = Astro.props;

---

<div class="row text-center">
  <div class="col-12">
    {selected ? (
      <>
        <h2>Selected <strong>{data.heading}</strong></h2>
        <p><a class="text-secondary" href="/repositories.html">Show <strong>more {data.heading}</strong></a></p>
      </>
    ) : (
      <>
        <h2>More <strong>{data.heading}</strong></h2>
        <p><a class="text-secondary" href="/index.html#repositories">by <strong>{header.name} {header.surname}</strong></a></p>
      </>
    )}
  </div>
</div>

{selected ? (
  <div class="row justify-content-center text-center">
    {data.accounts.map((account) => (
      <div class="col-4 col-sm-2">
        <ThumbnailGitHub src={account.thumbnail} userorg={account.github} />
        <p class="mt-2"><small><a class="text-body" href={`https://github.com/${account.github}`}>{account.name}</a></small></p>
      </div>
    ))}
  </div>
) : data.accounts.map((account) => (
  <div class="row" id={account.github}>
    <div class="col-lg-2 col-sm-3 col-4">
      <ThumbnailGitHub src={account.thumbnail} userorg={account.github} />
    </div>
    <div class="col-lg-10 col-sm-9 col-12 mt-3 mt-sm-0">
      <h3><a class="text-body" href={`https://github.com/${account.github}`}>{account.name}</a></h3>
      <p><small><a href={`https://github.com/${account.github}`}>github.com/{account.github}</a>&ensp;|&ensp;{account.active}</small></p>
      <p>{account.summary}</p>
      {account.projects.length > 0 && (
        <ul class="list-unstyled projects">
          {account.projects.map((project) => (
            <li>
              <a href={`https://github.com/${account.github}/${project.name}`}>{project.name}</a>
              {(project.status === 'inactive' || project.status === 'archived') && <span class={`status status-${project.status}`}>{project.status}</span>}
              <br /><small>{project.description}</small>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
))}
