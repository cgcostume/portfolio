---
import '../styles/main.scss';
import 'glightbox/dist/css/glightbox.min.css';
import Footer from '../components/Footer.astro';
import { config, header } from '../lib/data';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{header.name} {header.surname}</title>
    <meta name="description" content={`${header.title} ${header.name} ${header.surname} – ${header.leads.join(', ')}`} />
    <meta name="robots" content="index, follow" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />

    <noscript><style>.js-only { display: none; }</style></noscript>
  </head>
  <body id="page-top" data-flickr-key={config.flickr_api_key}>
    <slot />
    <section id="footer" class="container">
      <Footer />
    </section>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
